rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER SECURITY FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return isAuthenticated() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        getUserEmail() == 'uddinfahad89@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // =========================================================================
    // SYSTEM & HEALTH CHECK
    // =========================================================================
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // =========================================================================
    // USERS & STORE PROFILES
    // =========================================================================
    match /users/{userId} {
      allow read, write: if true;
    }

    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // =========================================================================
    // STORES & STAFF DIRECTORY
    // =========================================================================
    match /stores/{storeId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /staff_members/{staffId} {
      allow read, write: if true;
    }

    // =========================================================================
    // POS BUSINESS COLLECTIONS (MULTI-DOMAIN & MULTI-DEVICE CLOUD SYNC)
    // =========================================================================

    // Invoices / Bills Collection
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Products / Inventory Stock Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Customer Dues / Baki Khata
    match /customer_dues/{dueId} {
      allow read, write: if true;
    }

    // Cash Entries (Daybook Transactions)
    match /cash_entries/{entryId} {
      allow read, write: if true;
    }

    // Barcodes Collection
    match /barcodes/{barcodeId} {
      allow read, write: if true;
    }

    // Purchase Trips (Wholesale restock & expenses)
    match /purchase_trips/{tripId} {
      allow read, write: if true;
    }

    // Default safety rule for any other collection
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
